  {
    "title": "Heiliger Berg Wilzenberg",
    "title_en": null,
    "code": "PW 259 NRW",
    "operator": "Wanderfreunde Holthausen-Huxel 1979 e.V.",
    "start_address": "Landgasthof Vollmer-König, Hochstr. 1, 57392 Schmallenberg-Holthausen, Tel. 02974/321, kontakt@vollmer-koenig.de, http://www.vollmer-koenig.de",
    "start_hours": "Apr. - Okt. Mi - So 9.00 - 15.00 Uhr, Zielschluss 20.00 Uhr, Nov. -  Mrz. Mi - So 9.00 - 12.00 Uhr, Zielschluss 17.00 Uhr, witterungsabhängig, kein Winterdienst, tel. Anfrage ratsam, Mo und Di Ruhetag",
    "accessibility_notes": "Der Permanente Wanderweg ist vorübergehend gesperrt. Der Wilzenberg. Sehenswert die Wallfahrtskapelle mit Kreuzigungsstätte, 2 Fliehburgen aus der Frühzeit, das 28 m hohe Gipfelkreuz sowie der 125 Jahre alte Aussichtsturm. Von hier aus genießen Sie eine einzigartige Fernsicht.",
    "region": "nordrhein-westfalen",
    "region_label": "Nordrhein-Westfalen",
    "source_page": "https://www.dvv-wandern.de/permanente-wanderwege/nordrhein-westfalen/wanderweg/heiliger-berg-wilzenberg",
    "gpx_source_url": "https://www.dvv-wandern.de/files/documents/gpx-Permanente Wanderwege/nrw/PW-259-NRW-9km-gpx.gpx",
    "gpx_local_path": "dvv_gpx_data/gpx/nordrhein-westfalen/PW-259-NRW-9km-gpx.gpx"
  },
