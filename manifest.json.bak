  {
    "title": "Rinchnach/Bayerischer Wald",
    "title_en": null,
    "code": "PW 118 NDB",
    "operator": "Gemeinde Rinchnach",
    "start_address": "Gasthof \"Rinchnacher Hof\", Hofmarkt 9 (Ortskern), 94269 Rinchnach, Tel. 09921/7873",
    "start_hours": "tägl. 8.00 Uhr - 18.00 Uhr,   20.00 Uhr",
    "accessibility_notes": "Der 12 km lange Panoramablick-Rundwanderweg zählt zu den schönsten der Region. Nicht nur die Abwechslung vorbei an Wiesen und Feldern, durch kleine Wälder und durch viele Dörfer, sondern auch die vielen tollen Fernblicke, die sich immer wieder bieten, machen diesen Wanderweg so attraktiv. Der 5 km-Klosterwaldrundweg führt am beliebten Fledermaus-Waldspielplatz mit Lehr- und Fitnesspfad vorbei und durch den ehemaligen Klosterwald am Ortsrand. Im Winter je nach Schneelage nicht begehbar.",
    "region": "niederbayern",
    "region_label": "Niederbayern",
    "source_page": "https://www.dvv-wandern.de/permanente-wanderwege/niederbayern/wanderweg/rinchnachbayerischer-wald",
    "gpx_source_url": "https://www.dvv-wandern.de/files/documents/gpx-Permanente Wanderwege/ndb/PW-118-NDB-5km-gpx.gpx",
    "gpx_local_path": "dvv_gpx_data/gpx/niederbayern/PW-118-NDB-5km-gpx.gpx"
  },
