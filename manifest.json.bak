  {
    "title": "Über die Wasserscheide",
    "title_en": null,
    "code": "PW 366 FR",
    "operator": "Deutsch-Amerikanischer Wanderclub e.V. Ansbach",
    "start_address": "Gasthaus Vogel, Oberdombach 16, 91522 Ansbach, Tel. 09823/333",
    "start_hours": "Mo - So 9.00 - 17.00 Uhr, Mittwoch Ruhetag",
    "accessibility_notes": "Der Weg verläuft teilweise gemeinsam mit dem Fernwanderweg „Europäische Wasserscheide“. Er ist geprägt von einer herrlichen Strecke durch Wald und Flur. Sie können hier auf der sechs km oder vierzehn km Wanderstrecke die herrliche fränkische Natur genießen. Hinweis für Bahnreisende: Sie haben die Möglichkeit mit einem Anrufsammeltaxi nach Oberdombach zu kommen (Stadt AST mindestens eine Stunde vorher unter Tel. 0981/5005 anmelden). Der Wanderweg ist ganzjährig geöffnet – in den Wintermonaten wird nicht geräumt oder gestreut.",
    "region": "mittelfranken",
    "region_label": "Mittelfranken",
    "source_page": "https://www.dvv-wandern.de/permanente-wanderwege/mittelfranken/wanderweg/ueber-die-wasserscheide-421",
    "gpx_source_url": "https://www.dvv-wandern.de/files/documents/gpx-Permanente Wanderwege/fr-m/PW-366-FR-6km-gpx.gpx",
    "gpx_local_path": "dvv_gpx_data/gpx/mittelfranken/PW-366-FR-6km-gpx.gpx"
  },
