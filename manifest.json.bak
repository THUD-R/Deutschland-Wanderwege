  {
    "title": "Heimatblicke im Vorgebirge",
    "title_en": null,
    "code": "PW 316 NRW",
    "operator": "Wandergesellen Alt-Hürth 1991 e.V.",
    "start_address": "Bäckerei Landsberg, Königstr. 78, 53332 Bornheim, Tel. 02222/2673, info@baeckerei-landsberg.de",
    "start_hours": "Mo - Fr 6.00 - 18.30 Uhr, Sa 6.00 - 13.00 Uhr, So 7.30 - 16.30 Uhr",
    "accessibility_notes": "Der Wanderweg ist ganzjährig begehbar - kein Winterdienst. Wenn man die Höhe erreicht hat, findet man rechts einen Aussichtsturm, der dem Wanderweg den Namen gegeben hat. Im Wald begleitet den Wanderer, ein tiefer Graben – Reste des ehemaligen Römerkanal. Vorbei am sog. Kamelleboom, dem Eisernen Mann sowie dem Dom vom Vorgebirge im Ortsteil Brenig.",
    "region": "nordrhein-westfalen",
    "region_label": "Nordrhein-Westfalen",
    "source_page": "https://www.dvv-wandern.de/permanente-wanderwege/nordrhein-westfalen/wanderweg/heimatblicke-im-vorgebirge-162",
    "gpx_source_url": "https://www.dvv-wandern.de/files/documents/gpx-Permanente Wanderwege/nrw/PW-316-NRW-7km-gpx.gpx",
    "gpx_local_path": "dvv_gpx_data/gpx/nordrhein-westfalen/PW-316-NRW-7km-gpx.gpx"
  },
